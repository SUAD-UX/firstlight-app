# Copy these into Vercel → Project → Settings → Environment Variables
# (NOT into any file that gets committed — this example file is the exception.)

# Supabase dashboard → Project Settings → API:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase dashboard → Project Settings → API Keys → service_role (reveal, copy).
# Server-side only — the /api/board route uses it; it is never sent to browsers.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Why-chat (optional). Any OpenAI-compatible endpoint works. When unset,
# /api/why uses the built-in deterministic narrator instead — the panel
# works either way, and figures come only from the engine's evidence object.
# WHY_API_KEY=your-provider-key
# WHY_API_URL=https://api.groq.com/openai/v1/chat/completions
# WHY_MODEL=openai/gpt-oss-120b

# ── Telegram alerts (webhook + checker) ─────────────────────────────────────
# Token from @BotFather. It is a password: it only ever lives here in the
# Vercel env vars — never in code, GitHub, chats or screenshots.
TELEGRAM_BOT_TOKEN=1234567890:AA-your-botfather-token

# Long random text you invent. Registered once in the setWebhook URL and
# set here — Telegram must prove itself with it on every update.
TELEGRAM_WEBHOOK_SECRET=invent-30-plus-random-characters

# A DIFFERENT long random text you invent. Lives here AND once inside the
# Supabase pg_cron SQL job — proves cron calls are yours.
TELEGRAM_CRON_SECRET=invent-another-30-plus-random-characters
